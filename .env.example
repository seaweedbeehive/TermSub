# TermSub Environment Configuration
# Copy this file to .env and fill in your actual API keys.

# Required: Google Gemini API key (used for translation & analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Required for Groq transcription provider
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API key (not currently used for transcription)
OPENAI_API_KEY=

# Database
DATABASE_URL=sqlite:///./termsub.db

# File storage
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# ---------------------------------------------------------------------------
# Transcription Provider
# ---------------------------------------------------------------------------
# Options:
#   "groq"   — fastest, cloud-hosted Whisper (default)
#   "gemini" — Google Gemini 1.5 Flash, returns structured JSON
#   "local"  — offline CPU inference via faster-whisper
TRANSCRIPTION_PROVIDER=groq

# Groq model (only used when TRANSCRIPTION_PROVIDER=groq)
GROQ_WHISPER_MODEL=whisper-large-v3

# Local model (only used when TRANSCRIPTION_PROVIDER=local)
# faster-whisper sizes: tiny, base, small, medium, large-v1, large-v2, large-v3
LOCAL_WHISPER_MODEL=large-v3

# Local hardware settings
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

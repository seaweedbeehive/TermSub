# TermSub Environment Configuration
# Copy this file to .env and fill in your actual API keys.

# Required: OpenAI API key (used for transcription, translation & analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=postgresql://termsub:termsub@db:5432/termsub

# File storage
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# JWT signing secret (required).
# MUST be a strong, randomly generated string of at least 32 characters.
# The app will refuse to start with empty, default, or weak secrets.
# Generate one with: openssl rand -base64 32
# Do not use the default value in production.
JWT_SECRET_KEY=change-me-in-production

# Email (Resend) - optional; leave blank to disable sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=TermSub <hello@termsub.eedbee.app>
RESEND_VERIFY_TEMPLATE_ALIAS=verification
RESEND_WELCOME_TEMPLATE_ALIAS=welcome

# Frontend origin used for CORS (required).
# MUST exactly match the origin that serves the TermSub frontend.
# The default below assumes the backend is also serving the frontend files.
# If you run the frontend on a separate dev server, update this to that origin
# (e.g., http://localhost:5173 for Vite, http://localhost:3000 for a static server,
# or https://termsub.eedbee.app in production).
FRONTEND_BASE_URL=http://localhost:8000

# Redis connection limits.
# These keep total Redis connections under Render's 50-connection cap.
# Celery worker: CELERY_WORKER_CONCURRENCY × (broker + backend pools).
# Shared app pool: used by web service and worker progress publishes.
# Render's free Redis plan allows 50 simultaneous connections.
CELERY_WORKER_CONCURRENCY=5
CELERY_BROKER_POOL_LIMIT=3
CELERY_REDIS_MAX_CONNECTIONS=3
CELERY_RESULT_BACKEND_MAX_CONNECTIONS=3
REDIS_MAX_CONNECTIONS=15

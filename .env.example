# TermSub Environment Configuration
# Copy this file to .env and fill in your actual API keys.

# Required: Google Gemini API key (used for transcription, translation & analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite:///./termsub.db

# File storage
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# ---------------------------------------------------------------------------
# Transcription Provider
# ---------------------------------------------------------------------------
# Options:
#   "gemini" — Google Gemini Flash, returns structured JSON (default)
#   "local"  — offline CPU inference via faster-whisper
TRANSCRIPTION_PROVIDER=gemini

# Local model (only used when TRANSCRIPTION_PROVIDER=local)
# faster-whisper sizes: tiny, base, small, medium, large-v1, large-v2, large-v3
LOCAL_WHISPER_MODEL=large-v3

# Local hardware settings
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
